---
const baseUrl = import.meta.env.BASE_URL;
---
<header class="site-header"><div><a class="brand" href={baseUrl}><img src={`${baseUrl}assets/r2-d2-icon.svg`} alt="R2-D2 inspired astromech icon" /><span>THE BEAR<small>ENGINEERING WORKSPACE</small></span></a><nav aria-label="Primary navigation"><a href={`${baseUrl}#about`}>About</a><a href={`${baseUrl}#domains`}>Domains</a><a href={`${baseUrl}#work`}>Work</a><a href={`${baseUrl}#architecture`}>Approach</a><a href={`${baseUrl}#experience`}>Experience</a></nav><a class="header-contact" href={`${baseUrl}#contact`}>Start a conversation ↘</a></div></header>

<style>.brand img{width:30px;height:30px;display:block;flex:none;border:1px solid var(--acid);background:#0b0d0e}</style>
