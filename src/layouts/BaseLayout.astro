---
import '../styles/global.css';

interface Props { title: string; description?: string; }

const { title, description = 'Professional portfolio of Luiz H. Consolmagno, Senior Software Engineer and Technical Architect.' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#0b0d0e" /><link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" /><title>{title} | The Bear</title><style is:global>:root{--acid:#ff862e}</style></head><body><slot /></body></html>
