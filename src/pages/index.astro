---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import DomainItem from '../components/DomainItem.astro'; import RepositoryCard from '../components/RepositoryCard.astro'; import { domains } from '../data/domains';
const baseUrl = import.meta.env.BASE_URL;
const repositories = [
  { index: '01', title: 'RestaurantOS AI Platform', category: 'Restaurant technology · AI', description: 'Restaurant operating system for digital menus, ordering, payments, customer experience and automation.', technologies: 'Python · AI · SaaS', href: 'https://github.com/thebearconsolmagno/restaurantos-ai-platform' },
  { index: '02', title: 'Industrial IoT Simulator', category: 'Industrial systems', description: 'A Python codebase for exploring telemetry, automation and industrial IoT workflows.', technologies: 'Python · IoT · Telemetry', href: 'https://github.com/thebearconsolmagno/industrial_iot_simulato' },
  { index: '03', title: 'Game Deals', category: 'Application engineering', description: 'A public Python application project from the independent engineering portfolio.', technologies: 'Python · Application', href: 'https://github.com/thebearconsolmagno/game-deals' },
  { index: '04', title: 'CI/CD Factory', category: 'DevOps · DevSecOps', description: 'Visual control plane for creating, validating and delivering CI/CD blueprints across multiple stacks and platforms.', technologies: 'Kubernetes · Terraform · Helm', href: 'https://github.com/thebearconsolmagno/ci_cd_factory' },
  { index: '05', title: 'Fleet & Route Optimizer', category: 'Logistics intelligence · AI', description: 'Enterprise logistics platform for multi-tenant fleet management, route optimization, telemetry and AI-assisted dispatch.', technologies: 'FastAPI · React · Kubernetes', href: 'https://github.com/thebearconsolmagno/fleet_and_route_optimizer' },
  { index: '06', title: 'Pentest Playground', category: 'Cybersecurity', description: 'Local-only security lab that compares vulnerable and secure web implementations across common attack scenarios.', technologies: 'Flask · PostgreSQL · Docker', href: 'https://github.com/thebearconsolmagno/pentest_playground' },
];
---
<BaseLayout title="Engineering Workspace" description="Luiz H. Consolmagno — Senior Software Engineer and Technical Architect.">
<Header /><main>
<section class="hero section-shell" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="signal"></span>Independent engineering practice</p><p class="wordmark">THE BEAR<br /><span>ENGINEERING WORKSPACE</span></p><h1 id="hero-title">Systems that carry<br />real operational weight.</h1><p class="hero-lede">Senior Software Engineer and Technical Architect designing software systems, automation platforms, infrastructure and industrial solutions.</p><div class="actions"><a class="button primary" href="#work">Explore engineering work <span>↘</span></a><a class="button" href="https://github.com/thebearconsolmagno/" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a></div></div><div class="system-map" aria-label="Diagram showing the layers of a dependable engineering system"><div class="map-top"><span>SYSTEMS VIEW</span><span class="live">● WORKING TOGETHER</span></div><p class="map-intro">A dependable system is more than an application. Each layer supports the next.</p><div class="map-body"><div class="node"><span>01 · PRODUCT EXPERIENCE<small>What people use</small></span></div><i></i><div class="node"><span>02 · SERVICES & INTEGRATION<small>How parts communicate</small></span></div><i></i><div class="node data"><span>03 · DATA<small>What informs decisions</small></span></div><i></i><div class="node"><span>04 · PLATFORM & DELIVERY<small>How it is deployed and operated</small></span></div><i></i><div class="node monitor"><span>05 · OBSERVABILITY<small>How it is understood and improved</small></span></div></div><div class="map-footer"><span>DESIGN → BUILD → RUN → IMPROVE</span><span>THE SYSTEM, NOT JUST THE CODE</span></div></div></section>
<section id="about" class="positioning section-shell"><p class="eyebrow">About / 02</p><div><h2>Luiz H. Consolmagno.<br />Engineering systems where software meets operations and the physical world.</h2><div class="about-copy"><p>I am a Senior Software Engineer, AI Engineer and Technical Architect with a multidisciplinary path across software development, DevOps, automation, industrial systems and technical leadership.</p><p>My work is grounded in real operating environments: building applications, connecting systems, improving workflows, applying AI-assisted engineering where it creates practical value, and making infrastructure dependable enough for the people who rely on it.</p></div></div></section>
<section id="domains" class="section-shell section"><header><p class="eyebrow">Capabilities / 03</p><h2>Engineering domains</h2><p class="section-note">Technical breadth, connected by a systems-first way of working. Select a domain to see the work behind it.</p></header><div class="domain-list">{domains.map((domain) => <DomainItem number={domain.number} title={domain.title} href={`${baseUrl}domains/${domain.slug}/`}>{domain.summary}</DomainItem>)}</div></section>
<section id="work" class="section-shell section work"><header><p class="eyebrow">Selected work / 04</p><h2>Public work,<br />directly inspectable.</h2><p class="section-note">Original engineering projects only. Every entry links directly to its public repository.</p></header><div class="repository-grid">{repositories.map((repository) => <RepositoryCard {...repository} />)}</div></section>
<section id="architecture" class="approach section-shell"><div><p class="eyebrow">Method / 05</p><h2>Architecture is a practice,<br />not a diagram.</h2><p>Good systems make the important things explicit: how they fail, how they are operated, and how they can change.</p></div><ol><li><span>01</span><strong>Design for failure</strong><p>Make recovery, degradation and operational visibility part of the first design.</p></li><li><span>02</span><strong>Automate repeatable work</strong><p>Free people from fragile routines and give systems consistent behavior.</p></li><li><span>03</span><strong>Keep systems observable</strong><p>Decisions improve when the state and flow of a system can be understood.</p></li><li><span>04</span><strong>Build for evolution</strong><p>Prefer clear boundaries and maintainable choices over accidental complexity.</p></li></ol></section>
<section class="profile"><div class="profile-inner"><div><p class="eyebrow">Technical depth / 06</p><h2>Engineering capability,<br />organised by system layer.</h2><p class="profile-intro">A practical toolkit built across product delivery, operational systems and infrastructure—not a collection of disconnected keywords.</p></div><div class="profile-groups"><div><span>01 / CORE LANGUAGES</span><div><h3>Languages selected for the problem, not the trend.</h3><p>Python · Java · JavaScript · TypeScript · C · C# · PHP · Ruby · Bash · SQL</p></div></div><div><span>02 / APPLICATIONS</span><div><h3>Software people and operations can depend on.</h3><p>Backend services · REST APIs · Web platforms · Mobile applications · Desktop interfaces · Cross-platform delivery · Workflow automation · Performance-aware design</p></div></div><div><span>03 / FRONTEND & INTERFACES</span><div><h3>Clear interfaces for complex technical systems.</h3><p>React · TypeScript · Astro · HTML5 · CSS3 · SCSS · Responsive design · Accessibility · Design systems · UI architecture · Frontend performance</p></div></div><div><span>04 / BACKEND & DATA</span><div><h3>Reliable data flows behind the interface.</h3><p>Django · Flask · FastAPI · Spring Boot · Quarkus · Symfony · SQL · PostgreSQL · MySQL · MariaDB · MongoDB · JSON · Reporting and analytics</p></div></div><div><span>05 / INTEGRATION</span><div><h3>Connecting systems without losing control of the flow.</h3><p>API design · REST · JSON · MQTT · Z-Wave · Message-driven workflows · Device integration · Legacy system interoperability · eBay API integration</p></div></div><div><span>06 / PLATFORM & DEVOPS</span><div><h3>Environments designed for repeatable delivery and operation.</h3><p>Linux · Ubuntu Server · Red Hat Enterprise Linux · Oracle technologies · Docker · Kubernetes · Proxmox · Terraform · Ansible · CI/CD · Git · GitHub · GitLab · Apache Tomcat</p></div></div><div><span>07 / OBSERVABILITY & RELIABILITY</span><div><h3>Systems made visible before they become critical.</h3><p>Prometheus · Grafana · Monitoring · Logging · Alerting · Performance analysis · Failure-aware design · Infrastructure automation · Operational runbooks</p></div></div><div><span>08 / CYBERSECURITY</span><div><h3>Security treated as an engineering property.</h3><p>Security architecture · Threat modelling · Access control · IAM-aware design · Secure configuration · OWASP practices · Authorized pentesting · Vulnerability management · Hardening · Incident alerting</p></div></div><div><span>09 / INDUSTRIAL & IOT</span><div><h3>Software operating alongside physical systems.</h3><p>Industrial automation · IoT · Telemetry · PLC-oriented environments · Schneider systems · Raspberry Pi · Arduino · ESP · Worker tracking · Safety systems</p></div></div><div><span>10 / AI ENGINEERING</span><div><h3>Intelligence integrated with accountability.</h3><p>AI-assisted engineering · RAG pipelines · Knowledge retrieval · LLM application integration · Intelligent automation · Decision support · Predictive maintenance · Evaluation and guardrails · Human-in-the-loop design</p></div></div><div><span>11 / ARCHITECTURE</span><div><h3>Systems shaped for change, failure and maintainability.</h3><p>System design · Service boundaries · Platform architecture · Observability · Resilience · Technical leadership · Documentation · Continuous improvement</p></div></div></div></div></section>
<section id="experience" class="section-shell section"><header><p class="eyebrow">Trajectory / 07</p><h2>Experience in context.</h2></header><div class="timeline"><article><time>2024—2025</time><div><h3>DevOps Engineer <span>Green Solutions / Gruppo VGS</span></h3><p>Security and automation systems for tunnel, mining and industrial operations: real-time tracking, access control, alerts and server-side integration.</p></div></article><article><time>2024</time><div><h3>Senior Software Engineer / DevOps <span>SIRMEC</span></h3><p>Process optimization, data-driven reporting and automation for sales, production and transportation workflows.</p></div></article><article><time>2023</time><div><h3>DevOps Engineer / Senior Software Engineer <span>Vemar</span></h3><p>Integrated automation across IoT devices, residential and industrial systems, embedded platforms and real-time data.</p></div></article></div></section>
<section id="contact" class="contact section-shell"><p class="eyebrow">Contact / 08</p><div><h2>Let’s build something<br />that has to work.</h2><aside><p>Have a technical challenge, engineering project or architecture problem? I’m open to thoughtful conversations.</p><p class="contact-links"><a href="mailto:consolmagno.luiz@gmail.com">Email ↗</a><a href="https://it.linkedin.com/in/luizconsolmagno" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://wa.me/393920959078" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a href="https://github.com/thebearconsolmagno/" target="_blank" rel="noopener noreferrer">GitHub ↗</a></p></aside></div></section>
</main><Footer /></BaseLayout>

<style>
  .repository-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 960px) { .repository-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .repository-grid { grid-template-columns: 1fr; } }
  .map-intro { margin: 22px 0 14px; color: var(--muted); font-size: 12px; line-height: 1.55; }
  .system-map .node { min-height: 47px; align-items: center; }
  .system-map .node span { display: grid; gap: 2px; }
  .system-map .node small { color: var(--muted); font: 400 9px/1.25 var(--sans); }
  .profile-intro { margin-top: 24px; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .profile-groups h3 { margin: 0 0 6px; color: var(--text); font-size: 15px; letter-spacing: -.02em; }
</style>
