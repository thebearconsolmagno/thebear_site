---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import DomainItem from '../components/DomainItem.astro'; import RepositoryCard from '../components/RepositoryCard.astro'; import { domains } from '../data/domains';
const baseUrl = import.meta.env.BASE_URL;
const repositories = [
  { index: '01', title: 'Ghost', category: 'Enterprise software · Operations', description: 'Group-wide financial and operational platform for revenue, expenses, cash flow, invoices, materials, workforce costs, agreements, restaurants and municipal school-meal services.', technologies: 'Python · Flask · SQLAlchemy · Linux', featured: true, status: 'Private case study' },
  { index: '02', title: 'ForgeOS', category: 'AI engineering · Architecture', description: 'Multi-agent AI engineering platform for planning, execution, review, memory and controlled tool use.', technologies: 'Python · LLMs · AI Agents', href: 'https://github.com/thebearconsolmagno/forge-os', featured: true },
  { index: '03', title: 'La Quiete', category: 'Hospitality · Operations', description: 'Reservations, events and operational-management system with business integrations and production deployment.', technologies: 'Python · APIs · Linux', href: 'https://github.com/thebearconsolmagno/laquiete', featured: true },
  { index: '04', title: 'Industrial IoT Simulator', category: 'Industrial IoT · AI', description: 'Digital twins, telemetry, edge computing and predictive-maintenance workflows for AI-assisted industrial operations.', technologies: 'Python · MQTT · Telemetry', href: 'https://github.com/thebearconsolmagno/industrial_iot_simulato' },
  { index: '05', title: 'RestaurantOS', category: 'Restaurant technology · AI', description: 'Distributed restaurant-management platform for digital operations, real-time workflows and intelligent automation.', technologies: 'Python · AI · SaaS', href: 'https://github.com/thebearconsolmagno/restaurantos-ai-platform' },
  { index: '06', title: 'CI Risk Intelligence', category: 'AI engineering · DevSecOps', description: 'Machine-learning analysis of commits, pull requests, tests and delivery signals to identify CI/CD risk earlier.', technologies: 'Machine Learning · CI/CD · APIs', status: 'Private case study' },
  { index: '07', title: 'DevOps HomeLab', category: 'DevOps · Platform engineering', description: 'Hands-on platform environment for containers, Kubernetes, infrastructure as code, observability and deployment automation.', technologies: 'Docker · Kubernetes · Terraform', href: 'https://github.com/thebearconsolmagno/ci_cd_factory' },
  { index: '08', title: 'Fleet & Route Optimizer', category: 'Logistics · AI', description: 'Enterprise fleet, routing and logistics platform with multi-tenant operations, telemetry and AI-assisted dispatch.', technologies: 'FastAPI · React · Kubernetes', href: 'https://github.com/thebearconsolmagno/fleet_and_route_optimizer' },
  { index: '09', title: 'Pentest Playground', category: 'Cybersecurity · DevSecOps', description: 'Application-security laboratory comparing vulnerable and secure implementations across realistic attack scenarios.', technologies: 'Flask · PostgreSQL · Docker', href: 'https://github.com/thebearconsolmagno/pentest_playground' },
];
---
<BaseLayout title="Engineering Workspace" description="Engineering portfolio of Luiz Consolmagno, Senior Software Engineer and Technical Architect specializing in Software Engineering, DevOps, DevSecOps, Cybersecurity, Industrial IoT and AI Engineering.">
<Header /><main>
<section class="hero section-shell" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="signal"></span>Independent engineering practice</p><p class="wordmark">THE BEAR<br /><span>ENGINEERING WORKSPACE</span></p><h1 id="hero-title">Systems that carry<br />real operational weight.</h1><p class="hero-lede">Senior Software Engineer | Technical Architect | DevOps & DevSecOps | AI Engineering | Cybersecurity</p><div class="actions"><a class="button primary" href="#work">Explore engineering work <span>↘</span></a><a class="button" href="https://github.com/thebearconsolmagno/" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a></div></div><div class="system-map" aria-label="Diagram showing the layers of a dependable engineering system"><div class="map-top"><span>SYSTEMS VIEW</span><span class="live">● WORKING TOGETHER</span></div><p class="map-intro">A dependable system is more than an application. Each layer supports the next.</p><div class="map-body"><div class="node"><span>01 · PRODUCT EXPERIENCE<small>What people use</small></span></div><i></i><div class="node"><span>02 · SERVICES & INTEGRATION<small>How parts communicate</small></span></div><i></i><div class="node data"><span>03 · DATA<small>What informs decisions</small></span></div><i></i><div class="node"><span>04 · PLATFORM & DELIVERY<small>How it is deployed and operated</small></span></div><i></i><div class="node monitor"><span>05 · OBSERVABILITY<small>How it is understood and improved</small></span></div></div><div class="map-footer"><span>DESIGN → BUILD → RUN → IMPROVE</span><span>THE SYSTEM, NOT JUST THE CODE</span></div></div></section>
<section id="about" class="positioning section-shell"><p class="eyebrow">About / 02</p><div><h2>Luiz H. Consolmagno.<br />Engineering systems where software meets operations and the physical world.</h2><div class="about-copy"><p>I am a Senior Software Engineer and Technical Architect with many years of experience across backend engineering, system architecture, microservices, Linux, DevOps, Platform Engineering and DevSecOps.</p><p>My work connects software, infrastructure, security and Industrial IoT. More recently, I have expanded that foundation into AI Engineering, integrating LLMs, RAG and AI agents into practical engineering and operational workflows.</p></div></div></section>
<section id="domains" class="section-shell section"><header><p class="eyebrow">Capabilities / 03</p><h2>Engineering domains</h2><p class="section-note">Technical breadth, connected by a systems-first way of working. Select a domain to see the work behind it.</p></header><div class="domain-list">{domains.map((domain) => <DomainItem number={domain.number} title={domain.title} href={`${baseUrl}domains/${domain.slug}/`}>{domain.summary}</DomainItem>)}</div></section>
<section id="work" class="section-shell section work"><header><div><p class="eyebrow">Selected work / 04</p><h2>Completed projects,<br />built for real operations.</h2></div><p class="section-note">Explore the public repositories or request details about private case studies.</p></header><div class="project-controls" aria-label="Project filters"><button class="active" data-filter="all" aria-pressed="true">All projects</button><button data-filter="ai" aria-pressed="false">AI</button><button data-filter="devops" aria-pressed="false">DevOps</button><button data-filter="industrial" aria-pressed="false">Industrial IoT</button><button data-filter="cybersecurity" aria-pressed="false">Cybersecurity</button><label><span class="sr-only">Search projects</span><input type="search" data-project-search placeholder="Search projects or technologies" /></label></div><p class="project-count" aria-live="polite"><span data-project-count>{repositories.length}</span> completed projects</p><div class="repository-grid">{repositories.map((repository) => <RepositoryCard {...repository} />)}</div></section>
<section id="architecture" class="approach section-shell"><div><p class="eyebrow">Method / 05</p><h2>Architecture is a practice,<br />not a diagram.</h2><p>Good systems make the important things explicit: how they fail, how they are operated, and how they can change.</p></div><ol><li><span>01</span><strong>Design for failure</strong><p>Make recovery, degradation and operational visibility part of the first design.</p></li><li><span>02</span><strong>Automate repeatable work</strong><p>Free people from fragile routines and give systems consistent behavior.</p></li><li><span>03</span><strong>Keep systems observable</strong><p>Decisions improve when the state and flow of a system can be understood.</p></li><li><span>04</span><strong>Build for evolution</strong><p>Prefer clear boundaries and maintainable choices over accidental complexity.</p></li></ol></section>
<section class="profile"><div class="profile-inner"><div><p class="eyebrow">Technical depth / 06</p><h2>Engineering capability,<br />organised by system layer.</h2><p class="profile-intro">A practical toolkit built across product delivery, operational systems and infrastructure—not a collection of disconnected keywords.</p></div><div class="profile-groups"><div><span>01 / CORE LANGUAGES</span><div><h3>Languages selected for the problem, not the trend.</h3><p>Python · Java · JavaScript · TypeScript · C · C# · PHP · Ruby · Bash · SQL</p></div></div><div><span>02 / APPLICATIONS</span><div><h3>Software people and operations can depend on.</h3><p>Backend services · REST APIs · Web platforms · Mobile applications · Desktop interfaces · Cross-platform delivery · Workflow automation · Performance-aware design</p></div></div><div><span>03 / FRONTEND & INTERFACES</span><div><h3>Clear interfaces for complex technical systems.</h3><p>React · TypeScript · Astro · HTML5 · CSS3 · SCSS · Responsive design · Accessibility · Design systems · UI architecture · Frontend performance</p></div></div><div><span>04 / BACKEND & DATA</span><div><h3>Reliable data flows behind the interface.</h3><p>Django · Flask · FastAPI · Spring Boot · Quarkus · Symfony · SQL · PostgreSQL · MySQL · MariaDB · MongoDB · JSON · Reporting and analytics</p></div></div><div><span>05 / INTEGRATION</span><div><h3>Connecting systems without losing control of the flow.</h3><p>API design · REST · JSON · MQTT · Z-Wave · Message-driven workflows · Device integration · Legacy system interoperability · eBay API integration</p></div></div><div><span>06 / PLATFORM & DEVOPS</span><div><h3>Environments designed for repeatable delivery and operation.</h3><p>Linux · Ubuntu Server · Red Hat Enterprise Linux · Oracle technologies · Docker · Kubernetes · Proxmox · Terraform · Ansible · CI/CD · Git · GitHub · GitLab · Apache Tomcat</p></div></div><div><span>07 / OBSERVABILITY & RELIABILITY</span><div><h3>Systems made visible before they become critical.</h3><p>Prometheus · Grafana · Monitoring · Logging · Alerting · Performance analysis · Failure-aware design · Infrastructure automation · Operational runbooks</p></div></div><div><span>08 / CYBERSECURITY</span><div><h3>Security treated as an engineering property.</h3><p>Security architecture · Threat modelling · Access control · IAM-aware design · Secure configuration · OWASP practices · Authorized pentesting · Vulnerability management · Hardening · Incident alerting</p></div></div><div><span>09 / INDUSTRIAL & IOT</span><div><h3>Software operating alongside physical systems.</h3><p>Industrial automation · IoT · Telemetry · PLC-oriented environments · Schneider systems · Raspberry Pi · Arduino · ESP · Worker tracking · Safety systems</p></div></div><div><span>10 / AI ENGINEERING</span><div><h3>Intelligence integrated with accountability.</h3><p>AI-assisted engineering · RAG pipelines · Knowledge retrieval · LLM application integration · Intelligent automation · Decision support · Predictive maintenance · Evaluation and guardrails · Human-in-the-loop design</p></div></div><div><span>11 / ARCHITECTURE</span><div><h3>Systems shaped for change, failure and maintainability.</h3><p>System design · Service boundaries · Platform architecture · Observability · Resilience · Technical leadership · Documentation · Continuous improvement</p></div></div></div></div></section>
<section id="experience" class="section-shell section"><header><p class="eyebrow">Trajectory / 07</p><h2>Experience in context.</h2></header><div class="timeline"><article><time>May 2025—Present</time><div><h3>Senior Software Developer | AI Engineering & Software Architecture <span>Independent Software Engineering & AI Projects</span></h3><p>End-to-end software, AI and infrastructure solutions across backend engineering, distributed systems, automation, data, Industrial IoT, DevOps and cybersecurity.</p></div></article><article><time>Sep 2024—Mar 2025</time><div><h3>DevOps Engineer and Senior Software Engineer <span>Green Solutions / Gruppo VGS</span></h3><p>Security and automation systems for tunnel, mining and industrial operations: real-time tracking, access control, alerts and server-side integration.</p></div></article><article><time>Jan 2024—Jul 2024</time><div><h3>Senior Software Engineer | DevOps <span>SIRMEC</span></h3><p>Process optimization, data-driven reporting and automation for sales, production and transportation workflows.</p></div></article><article><time>Mar 2023—Dec 2023</time><div><h3>Senior Software Engineer | DevOps Engineer <span>Vemar</span></h3><p>Integrated automation across IoT devices, residential and industrial systems, embedded platforms and real-time data.</p></div></article><article><time>Jan 2020—Dec 2022</time><div><h3>Co-founder | Digital Transformation Initiative <span>Avanti il SUD</span></h3><p>Helped small businesses adopt e-commerce, workflow automation and practical digital operating models.</p></div></article><article><time>Mar 2004—Dec 2019</time><div><h3>Senior Software & Game Developer | Full-Stack Engineer <span>NewLand Games</span></h3><p>Delivered multi-platform web, mobile, desktop and distributed software, including backend services, data systems and high-performance interactive products.</p></div></article></div></section>
<section id="education" class="education section-shell section"><header><div><p class="eyebrow">Education / 08</p><h2>Continuous learning,<br />applied in practice.</h2></div><p class="section-note">Academic education and professional development supporting current work across software, infrastructure, AI and security.</p></header><div class="education-grid"><article class="education-card current"><div class="education-meta"><time>May 2025—Present</time><span>Current · Final stage</span></div><h3>Digital Professional Qualification in Software Engineering, Data Analytics and IT Security</h3><p class="institution">MSIT GmbH / Masterschool · Germany · Remote</p><p>Full-time professional qualification combining contemporary software engineering, data analytics and IT-security practice. The current programme documentation describes live online instruction, applied technical work and career-oriented project development.</p><ul><li>Software engineering and backend foundations</li><li>Data analytics and applied AI context</li><li>IT security, systems and operational reliability</li><li>Practical projects and career preparation</li></ul><p class="education-note">Started in May 2025 and currently approaching completion. The exact specialization and resulting certificates will be listed after confirmation from the personal enrolment record.</p></article><article class="education-card"><div class="education-meta"><time>2009—2014</time><span>Postgraduate education</span></div><h3>Computer Programming, Specific Applications</h3><p class="institution">Universidade Paulista (UNIP) · Postgraduate / MBA</p><p>Advanced academic work in software development and applied computing, supporting a long-term professional foundation in programming, systems and technology.</p></article><article class="education-card"><div class="education-meta"><time>2023</time><span>Professional training</span></div><h3>DevOps Engineer Professional Training</h3><p class="institution">Vemar</p><p>Applied training in Linux environments, automation, deployment, infrastructure operations, connected systems and practical DevOps workflows.</p></article><article class="education-card"><div class="education-meta"><time>Completed</time><span>Computer science</span></div><h3>CS50x Introduction to Computer Science</h3><p class="institution">Harvard University · Professional development</p><p>Computer-science foundations, algorithms, data structures, programming and problem solving.</p></article><article class="education-card"><div class="education-meta"><time>In progress</time><span>Artificial intelligence</span></div><h3>CS50 Introduction to Artificial Intelligence with Python</h3><p class="institution">Harvard University · Professional development</p><p>Search, optimization, machine learning, neural networks, natural-language processing and AI systems implemented with Python.</p></article><article class="education-card"><div class="education-meta"><time>Additional study</time><span>Technical development</span></div><h3>Selected Technical Training</h3><p class="institution">Artificial Intelligence · Linux · Computer Networks</p><p>Ongoing professional study complementing hands-on work in backend engineering, infrastructure, security, distributed systems and AI Engineering.</p></article></div></section>
<section id="contact" class="contact section-shell"><p class="eyebrow">Contact / 09</p><div><h2>Let’s build something<br />that has to work.</h2><aside><p>Have a technical challenge, engineering project or architecture problem? I’m open to thoughtful conversations.</p><p class="contact-links"><a href="mailto:consolmagno.luiz@gmail.com">Email ↗</a><a href="https://it.linkedin.com/in/luizconsolmagno" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://wa.me/393920959078" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a href="https://github.com/thebearconsolmagno/" target="_blank" rel="noopener noreferrer">GitHub ↗</a></p></aside></div></section>
</main><Footer /></BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
  const projectCards = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
  const searchInput = document.querySelector<HTMLInputElement>('[data-project-search]');
  const projectCount = document.querySelector<HTMLElement>('[data-project-count]');
  let activeFilter = 'all';

  const updateProjects = () => {
    const term = searchInput?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    projectCards.forEach((card) => {
      const matchesFilter = activeFilter === 'all' || (card.dataset.category ?? '').includes(activeFilter);
      const matchesSearch = !term || (card.dataset.search ?? '').includes(term);
      const show = matchesFilter && matchesSearch;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (projectCount) projectCount.textContent = String(visible);
  };

  filterButtons.forEach((button) => button.addEventListener('click', () => {
    activeFilter = (button as HTMLElement).dataset.filter ?? 'all';
    filterButtons.forEach((item) => {
      const selected = item === button;
      item.classList.toggle('active', selected);
      item.setAttribute('aria-pressed', String(selected));
    });
    updateProjects();
  }));
  searchInput?.addEventListener('input', updateProjects);
</script>

<style>
  .repository-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .project-controls { display:flex; flex-wrap:wrap; gap:8px; margin:-10px 0 18px; }
  .project-controls button,.project-controls input { min-height:42px; border:1px solid var(--line); background:var(--panel); color:var(--text); padding:0 14px; font:500 11px var(--mono); text-transform:uppercase; letter-spacing:.05em; }
  .project-controls button { cursor:pointer; transition:background .2s,color .2s,border-color .2s; }
  .project-controls button:hover,.project-controls button.active { background:var(--acid); color:#171b12; border-color:var(--acid); }
  .project-controls label { margin-left:auto; }
  .project-controls input { width:min(290px,70vw); text-transform:none; }
  .project-controls input:focus { outline:2px solid var(--acid); outline-offset:2px; }
  .project-count { margin:0 0 18px; color:var(--muted); font:500 11px var(--mono); text-transform:uppercase; letter-spacing:.06em; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  [hidden] { display:none !important; }
  @media (max-width: 960px) { .repository-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .repository-grid { grid-template-columns: 1fr; } .project-controls label,.project-controls input { width:100%; margin-left:0; } }
  .map-intro { margin: 22px 0 14px; color: var(--muted); font-size: 12px; line-height: 1.55; }
  .system-map .node { min-height: 47px; align-items: center; }
  .system-map .node span { display: grid; gap: 2px; }
  .system-map .node small { color: var(--muted); font: 400 9px/1.25 var(--sans); }
  .system-map .map-footer { margin-top:18px; padding-top:13px; border-top:1px solid var(--line); display:grid; grid-template-columns:1fr; gap:6px; line-height:1.45; }
  .system-map .map-footer span:first-child { color:var(--acid); }
  .system-map .map-footer span:last-child { color:var(--text); text-align:right; }
  .education { border-top:1px solid var(--soft); }
  .education-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
  .education-card { border:1px solid var(--line); background:var(--panel); padding:25px; min-height:245px; }
  .education-card.current { grid-column:1/-1; background:linear-gradient(145deg,#171d1e,#101415); border-color:#566052; }
  .education-meta { display:flex; justify-content:space-between; gap:18px; margin-bottom:26px; font:500 10px/1.4 var(--mono); letter-spacing:.07em; text-transform:uppercase; color:var(--muted); }
  .education-meta time,.education-meta span:first-child { color:var(--acid); }
  .education-card h3 { margin:0 0 9px; font-size:22px; letter-spacing:-.035em; }
  .education-card .institution { color:var(--acid); font:500 11px/1.5 var(--mono); text-transform:uppercase; letter-spacing:.04em; }
  .education-card>p:not(.institution) { color:var(--muted); font-size:14px; line-height:1.7; }
  .education-card ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px 24px; margin:20px 0; padding:0; list-style:none; }
  .education-card li { color:#ced5d2; font-size:13px; }
  .education-card li::before { content:'↘'; color:var(--acid); margin-right:8px; }
  .education-note { border-top:1px solid var(--line); padding-top:14px; margin-bottom:0; }
  .profile-intro { margin-top: 24px; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .profile-groups h3 { margin: 0 0 6px; color: var(--text); font-size: 15px; letter-spacing: -.02em; }
  @media (max-width: 780px) { .education-grid { grid-template-columns:1fr; } .education-card.current { grid-column:auto; } .education-card ul { grid-template-columns:1fr; } .education-meta { align-items:flex-start; flex-direction:column; gap:5px; } .system-map .map-footer span:last-child { text-align:left; } }
</style>
